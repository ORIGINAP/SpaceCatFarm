  m_Name: C2_03b_Explore
  m_EditorClassIdentifier: Assembly-CSharp::QuestDefinition
  questName: "\uC8FC\uBCC0 \uD0D0\uC0AC"
  description: "\uCC29\uB959\uC9C0 \uBC14\uAE65\uC5D4 \uC800\uB9C8\uB2E4 \uB2E4\uB978
    \uAD11\uB9E5\uACFC \uD1A0\uC591\uC774 \uC788\uB294 \uC9C0\uC5ED(\uBC14\uC774\uC634)\uC774
    \uB137 \uC788\uC5B4\uC694. \uC0C8 \uC9C0\uC5ED\uC744 \uCC3E\uACE0 \uD0D0\uC0AC
    \uC720\uC801\uC744 \uC870\uC0AC\uD574\uC694."
  talk: "\uC774 \uBCC4\uC5D4 \uBAA8\uB798 \uC5B8\uB355 \uB9D0\uACE0\uB3C4 \uB208\uBC8C\uD310,
    \uC218\uC815 \uB4E4\uD310, \uC774\uB07C \uB2AA\uC774 \uC788\uB300\uC694! \uC2A4\uCE90\uB108\uB97C
    \uB4E4\uACE0 \uAC00\uAE4C\uC6B4 \uC9C0\uC5ED\uBD80\uD130 \uB458\uB7EC\uBD10\uC694."
  hint: "\uD654\uC0B4\uD45C\uB97C \uB530\uB77C \uC0C8 \uC9C0\uC5ED\uC73C\uB85C \xB7
    \uD0D0\uC0AC \uC2A4\uCE90\uB108(\uD074\uB9AD)\uB85C \uC720\uC801 \uBC29\uD5A5
    \uCC3E\uAE30 \u2192 \uC720\uC801 \uD074\uB9AD"
  padHint: "\uD654\uC0B4\uD45C\uB97C \uB530\uB77C \uC0C8 \uC9C0\uC5ED\uC73C\uB85C
    \xB7 \uC2A4\uCE90\uB108\uB97C \uB4E4\uACE0 RT \u2192 \uC720\uC801 \uACC1\uC5D0\uC11C
    A"
  tutorialTip: "\uC0C8 \uC9C0\uC5ED\uC5D0 \uCC98\uC74C \uB4E4\uC5B4\uAC00\uBA74 \uC774\uB984\uC774
    \uD06C\uAC8C \uB5A0\uC694. \uC720\uC801\uC744 \uC870\uC0AC\uD558\uBA74 \uADF8
    \uC9C0\uC5ED \uAD11\uBB3C\uACFC \uCF54\uC778\uC744 \uC5BB\uC5B4\uC694.\n\uBC14\uC774\uC634\uB9C8\uB2E4
    \uB098\uB294 \uAD11\uC11D\uC774 \uB2EC\uB77C\uC694: \uD639\uD55C\uC9C0 \uC54C\uB8E8\uBBF8\uB284
    \xB7 \uB9AC\uD2AC, \uC218\uC815 \uC9C0\uB300 \uD2F0\uD0C0\uB284 \xB7 \uB2E4\uC774\uC544\uBAAC\uB4DC,
    \uC774\uB07C \uC2B5\uC9C0 \uC6B0\uB77C\uB284."
