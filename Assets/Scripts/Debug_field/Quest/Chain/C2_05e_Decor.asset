  m_Name: C2_05e_Decor
  m_EditorClassIdentifier: Assembly-CSharp::QuestDefinition
  questName: "\uB9C8\uC744 \uAFB8\uBBF8\uAE30"
  description: "\uAFB8\uBBF8\uAE30 \uAC00\uAC8C\uC5D0\uC11C \uC0B0 \uC7A5\uC2DD\uC744
    \uB9C8\uC744\uC5D0 \uB193\uC73C\uBA74 \uB9C8\uC744 \uB9E4\uB825 \u2605\uC774
    \uC62C\uB77C\uC694. \uB9E4\uB825\uC774 \uB192\uC744\uC218\uB85D \uC154\uD2C0\uC774
    \uB5A0\uB0A0 \uB54C \uC9D0\uAC12\uC744 \uB354 \uBC1B\uC544\uC694."
  talk: "\uC8FC\uBBFC\uB4E4\uC774 \uC0C1\uC810\uAC00\uC5D0 \uAFB8\uBBF8\uAE30 \uAC00\uAC8C\uB97C
    \uC5F4\uC5C8\uC5B4\uC694! \uC7A5\uC2DD\uC744 \uB193\uC544 \uB9C8\uC744\uC744
    \uC608\uC058\uAC8C \uD558\uBA74 \uC18C\uBB38\uC774 \uB098\uC11C \uC154\uD2C0
    \uC9D0\uAC12\uB3C4 \uC62C\uB77C\uC694."
  hint: "[\uC0C1\uC810](B) \u2192 \uAFB8\uBBF8\uAE30 \uD0ED \u2192 \uC7A5\uC2DD \uC0AC\uAE30
    \u2192 \uB4E4\uACE0 \uB9C8\uC744\uC5D0 \uB193\uAE30"
  padHint: "\uC2ED\uC790\uD0A4 \u2192 \uC0C1\uC810 \u2192 LT/RT\uB85C \uAFB8\uBBF8\uAE30
    \u2192 \uC7A5\uC2DD \uC0AC\uAE30 \u2192 \uB4E4\uACE0 RT\uB85C \uB193\uAE30"
  tutorialTip: "\uB9E4\uB825 \uBCF4\uB108\uC2A4\uB294 \uC154\uD2C0 \uCC3D \uC704\uCABD\uC5D0
    \uBCF4\uC5EC\uC694. \uBE44\uC2FC \uC7A5\uC2DD\uC77C\uC218\uB85D \uB9E4\uB825\uC774
    \uCEE4\uC694.\n\uC7A5\uC2DD\uC740 \uC815\uD654\uB41C \uB545 \uC5B4\uB514\uB4E0
    \uB193\uC744 \uC218 \uC788\uACE0, \uD574\uCCB4\uD558\uBA74 \uB3CC\uB824\uBC1B\uC544\uC694."
